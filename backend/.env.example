# Flask Server Environment
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5000

# Security Keys
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-in-production
JWT_EXPIRATION_DAYS=7

# Cloudinary Storage (Optional - falls back to local storage if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS
CORS_ORIGINS=*
